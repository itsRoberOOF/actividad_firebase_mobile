rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'mediaType', 'mediaUrl',
          'cloudinaryPublicId', 'authorId', 'authorName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'mediaType', 'mediaUrl',
          'cloudinaryPublicId', 'authorId', 'authorName', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.cloudinaryPublicId is string
        && request.resource.data.cloudinaryPublicId.size() > 0
        && request.resource.data.cloudinaryPublicId.size() <= 300
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches('https://res[.]cloudinary[.]com/.*')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // Un like por usuario: el ID del documento es el UID de Firebase Auth.
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
